{
  "name": "rssify",
  "version": "0.1.0",
  "description": "Self-hosted scraper-to-RSS: scrape sites, summarize with a cheap AI model, serve RSS 2.0 feeds.",
  "type": "module",
  "bin": {
    "rssify": "bin/rssify.js"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "serve": "node src/cli.ts serve",
    "test": "RSSIFY_TEST=1 TZ=UTC node --test test/*.test.ts tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=25"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "hono": "^4.13.1",
    "jsdom": "^29.1.1",
    "node-cron": "^4.6.0",
    "openai": "^7.4.0",
    "pino": "^10.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
