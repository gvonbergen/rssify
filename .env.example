# RSSify secrets — copy to .env and fill in. Never commit .env.
# `rssify config set <key> <value>` writes these for you.

# LLM article extraction (OpenRouter or any OpenAI-compatible endpoint).
# Used by ai.api_key (ai.base_url in config.yaml).
AI_API_KEY=

# Cloud scraping backend (used when defaults.engine: firecrawl).
FIRECRAWL_API_KEY=

# Optional auth for the camofox backend (defaults.engine: camofox).
CAMOFOX_ACCESS_KEY=
